# nginx config template for the TechQuiz SPA.
# The nginx:alpine image runs envsubst over /etc/nginx/templates/*.template at startup, so ${PORT}
# is filled from the environment: container hosts (Render) inject PORT and route there; locally the
# web Dockerfile defaults PORT=80 so docker-compose keeps serving on 80. Only ${PORT} is an env var,
# so nginx's own $uri/$host references pass through envsubst untouched.
#
# Single-page app: every unknown URL must serve /index.html so React Router
# (BrowserRouter) can pick up the path client-side.

server {
    listen       ${PORT};
    listen  [::]:${PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Cache hashed assets aggressively. Vite emits files like
    # `index-Bq9bv_Nr.js` — the hash invalidates them on deploy.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: serve index.html for any non-asset path.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Disable cache for the entry HTML so users always get the latest bundle hashes.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # Gzip already-compressed bundles is wasteful; nginx-alpine has gzip on by default.
    # If we want Brotli later, switch the base image or add a sidecar.
}
